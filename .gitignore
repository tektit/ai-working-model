# Claude Code per-machine files, written through the .claude link
# On Windows the root .claude may be a directory junction (README "Working on
# Windows"); this keeps its contents out of `git add -A`. On Unix it is a symlink,
# which a directory pattern does not match.
/.claude/
**/.claude/settings.local.json
**/.claude/worktrees/
